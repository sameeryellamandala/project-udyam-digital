HOST=127.0.0.1
PORT=3000
DB_PATH=var/udyam.sqlite
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Local alternative: set AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b

# PostgreSQL conversation history (separate from SQLite orders).
# Set the real connection URL only in ignored .env.
DATABASE_URL=
# Optional: test server role must be able to create temporary test databases.
TEST_DATABASE_URL=

# Smart KYC private local storage and simulated reviewer access.
# Generate missing settings with npm run kyc:setup. Keep actual values private.
KYC_ENCRYPTION_KEY=
KYC_REVIEWER_TOKEN=

# Clerk customer accounts. Publishable key is public; secret key stays server-side.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
